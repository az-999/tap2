    ;; Handle bounced messages
    if (msg_bounced) {
        return (self, true);
    }
    
    ;; Parse incoming message
    int op = 0;
    if (slice_bits(in_msg) >= 32) {
        op = in_msg.preload_uint(32);
    }
    
    
    ;; Receive Deposit message
    if (op == 69877033) {
        var msg = in_msg~$Deposit$_load();
        self~$StakeMaster$_internal_binary_Deposit(msg);
        return (self, true);
    }
    
    ;; Receive DoMint message
    if (op == 2793121783) {
        var msg = in_msg~$DoMint$_load();
        self~$StakeMaster$_internal_binary_DoMint(msg);
        return (self, true);
    }
    
    ;; Receive TokenExcesses message
    if (op == 0xd53276db) {
        var msg = in_msg~$TokenExcesses$_load();
        self~$StakeMaster$_internal_binary_TokenExcesses(msg);
        return (self, true);
    }
    
    ;; Receive TokenNotification message
    if (op == 0x7362d09c) {
        var msg = in_msg~$TokenNotification$_load();
        self~$StakeMaster$_internal_binary_TokenNotification(msg);
        return (self, true);
    }
    
    ;; Receive ProxyMsg message
    if (op == 3891826139) {
        var msg = in_msg~$ProxyMsg$_load();
        self~$StakeMaster$_internal_binary_ProxyMsg(msg);
        return (self, true);
    }
    
    ;; Receive UpdateFeeAddress message
    if (op == 130433518) {
        var msg = in_msg~$UpdateFeeAddress$_load();
        self~$StakeMaster$_internal_binary_UpdateFeeAddress(msg);
        return (self, true);
    }
    
    ;; Receive UpdateNftAddress message
    if (op == 3529429755) {
        var msg = in_msg~$UpdateNftAddress$_load();
        self~$StakeMaster$_internal_binary_UpdateNftAddress(msg);
        return (self, true);
    }
    
    ;; Receive UpdateJettonAddress message
    if (op == 2933033334) {
        var msg = in_msg~$UpdateJettonAddress$_load();
        self~$StakeMaster$_internal_binary_UpdateJettonAddress(msg);
        return (self, true);
    }
    
    ;; Receive TransferOwnership message
    if (op == 1800991741) {
        var msg = in_msg~$TransferOwnership$_load();
        self~$StakeMaster$_internal_binary_TransferOwnership(msg);
        return (self, true);
    }
    
    ;; Receive empty message
    if ((op == 0) & (slice_bits(in_msg) <= 32)) {
        self~%$StakeMaster$_internal_empty();
        return (self, true);
    }
    
    return (self, false);
}

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    var msg_flags = cs~load_uint(4);
    var msg_bounced = -(msg_flags & 1);
    slice msg_sender_addr = __tact_verify_address(cs~load_msg_addr());
    __tact_context = (msg_bounced, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var self = $StakeMaster$_contract_load();
    
    ;; Handle operation
    int handled = self~$StakeMaster$_contract_router_internal(msg_bounced, in_msg);
    
    ;; Throw if not handled
    throw_unless(130, handled);
    
    ;; Persist state
    $StakeMaster$_contract_store(self);
}
