;; Routing of a Contract Stake
;;

((int, int, slice, slice, slice, int, int, int, int, int, int, int, int), int) $Stake$_contract_router_internal((int, int, slice, slice, slice, int, int, int, int, int, int, int, int) self, int msg_bounced, slice in_msg) impure inline_ref {
    ;; Handle bounced messages
    if (msg_bounced) {
        return (self, true);
    }
    
    ;; Parse incoming message
    int op = 0;
    if (slice_bits(in_msg) >= 32) {
        op = in_msg.preload_uint(32);
    }
    
    
    ;; Receive Claim message
    if (op == 1586636328) {
        var msg = in_msg~$Claim$_load();
        self~$Stake$_internal_binary_Claim(msg);
        return (self, true);
    }
    
    ;; Receive Restake message
    if (op == 1489790520) {
        var msg = in_msg~$Restake$_load();
        self~$Stake$_internal_binary_Restake(msg);
        return (self, true);
    }
    
    ;; Receive Withdraw message
    if (op == 3123246349) {
        var msg = in_msg~$Withdraw$_load();
        self~$Stake$_internal_binary_Withdraw(msg);
        return (self, true);
    }
    
    ;; Receive TransferTON message
    if (op == 271167746) {
        var msg = in_msg~$TransferTON$_load();
        self~$Stake$_internal_binary_TransferTON(msg);
        return (self, true);
    }
    
    ;; Receive ProxyMsg message
    if (op == 3891826139) {
        var msg = in_msg~$ProxyMsg$_load();
        self~$Stake$_internal_binary_ProxyMsg(msg);
        return (self, true);
    }
    
    ;; Receive empty message
    if ((op == 0) & (slice_bits(in_msg) <= 32)) {
        self~%$Stake$_internal_empty();
        return (self, true);
    }
    
    return (self, false);
}

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    var msg_flags = cs~load_uint(4);
    var msg_bounced = -(msg_flags & 1);
    slice msg_sender_addr = __tact_verify_address(cs~load_msg_addr());
    __tact_context = (msg_bounced, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var self = $Stake$_contract_load();
    
    ;; Handle operation
    int handled = self~$Stake$_contract_router_internal(msg_bounced, in_msg);
    
    ;; Throw if not handled
    throw_unless(130, handled);
    
    ;; Persist state
    $Stake$_contract_store(self);
}
