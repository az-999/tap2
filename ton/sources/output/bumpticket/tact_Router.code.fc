;;
;; Get methods of a Contract Router
;;

_ %getMainAddress() method_id(96933) {
    var self = $Router$_contract_load();
    var res = self~$Router$_fun_getMainAddress();
    return res;
}

_ %getPrizeAddress() method_id(124260) {
    var self = $Router$_contract_load();
    var res = self~$Router$_fun_getPrizeAddress();
    return res;
}

_ %getReferalAddress() method_id(109392) {
    var self = $Router$_contract_load();
    var res = self~$Router$_fun_getReferalAddress();
    return res;
}

_ %getValue() method_id(69972) {
    var self = $Router$_contract_load();
    var res = self~$Router$_fun_getValue();
    return res;
}

_ %getRefDivider() method_id(117871) {
    var self = $Router$_contract_load();
    var res = self~$Router$_fun_getRefDivider();
    return $Divider$_to_external(res);
}

_ %getPrizeDivider() method_id(71973) {
    var self = $Router$_contract_load();
    var res = self~$Router$_fun_getPrizeDivider();
    return $Divider$_to_external(res);
}

_ lazy_deployment_completed() method_id {
    return get_data().begin_parse().load_int(1);
}

;;
;; Routing of a Contract Router
;;

((slice, int, slice, slice, slice, int, (int, int), (int, int)), int) $Router$_contract_router_internal((slice, int, slice, slice, slice, int, (int, int), (int, int)) self, int msg_bounced, slice in_msg) impure inline_ref {
    ;; Handle bounced messages
    if (msg_bounced) {
        return (self, true);
    }
    
    ;; Parse incoming message
    int op = 0;
    if (slice_bits(in_msg) >= 32) {
        op = in_msg.preload_uint(32);
    }
    
    
    ;; Receive TransferOwnership message
    if (op == 1800991741) {
        var msg = in_msg~$TransferOwnership$_load();
        self~$Router$_internal_binary_TransferOwnership(msg);
        return (self, true);
    }
    
    ;; Receive ProxyMsg message
    if (op == 3531620403) {
        var msg = in_msg~$ProxyMsg$_load();
        self~$Router$_internal_binary_ProxyMsg(msg);
        return (self, true);
    }
    
    ;; Receive SetMainAddress message
    if (op == 2534796593) {
        var msg = in_msg~$SetMainAddress$_load();
        self~$Router$_internal_binary_SetMainAddress(msg);
        return (self, true);
    }
    
    ;; Receive SetPrizeAddress message
    if (op == 894415229) {
        var msg = in_msg~$SetPrizeAddress$_load();
        self~$Router$_internal_binary_SetPrizeAddress(msg);
        return (self, true);
    }
    
    ;; Receive SetReferalAddress message
    if (op == 1232702265) {
        var msg = in_msg~$SetReferalAddress$_load();
        self~$Router$_internal_binary_SetReferalAddress(msg);
        return (self, true);
    }
    
    ;; Receive UpdatePublicKey message
    if (op == 1599039702) {
        var msg = in_msg~$UpdatePublicKey$_load();
        self~$Router$_internal_binary_UpdatePublicKey(msg);
        return (self, true);
    }
    
    ;; Receive UpdateValue message
    if (op == 1382399430) {
        var msg = in_msg~$UpdateValue$_load();
        self~$Router$_internal_binary_UpdateValue(msg);
        return (self, true);
    }
    
    ;; Receive SetDividors message
    if (op == 4172235513) {
        var msg = in_msg~$SetDividors$_load();
        self~$Router$_internal_binary_SetDividors(msg);
        return (self, true);
    }
    
    ;; Receive Deposit message
    if (op == 2955650924) {
        var msg = in_msg~$Deposit$_load();
        self~$Router$_internal_binary_Deposit(msg);
        return (self, true);
    }
    
    ;; Receive empty message
    if ((op == 0) & (slice_bits(in_msg) <= 32)) {
        self~%$Router$_internal_empty();
        return (self, true);
    }
    
    ;; Receive Deploy message
    if (op == 2490013878) {
        var msg = in_msg~$Deploy$_load();
        self~$Router$_internal_binary_Deploy(msg);
        return (self, true);
    }
    
    return (self, false);
}

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    var msg_flags = cs~load_uint(4);
    var msg_bounced = -(msg_flags & 1);
    slice msg_sender_addr = __tact_verify_address(cs~load_msg_addr());
    __tact_context = (msg_bounced, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var self = $Router$_contract_load();
    
    ;; Handle operation
    int handled = self~$Router$_contract_router_internal(msg_bounced, in_msg);
    
    ;; Throw if not handled
    throw_unless(130, handled);
    
    ;; Persist state
    $Router$_contract_store(self);
}
