_ %getNftItemInit(int $item_index) method_id(81078) {
    int $item_index = $item_index;
    var self = $ShipAssembler$_contract_load();
    var res = self~$ShipAssembler$_fun_getNftItemInit($item_index);
    return $StateInit$_to_external(res);
}

_ %getOwner() method_id(102025) {
    var self = $ShipAssembler$_contract_load();
    var res = self~$ShipAssembler$_fun_getOwner();
    return res;
}

_ %get_nft_address_by_index(int $item_index) method_id(92067) {
    int $item_index = $item_index;
    var self = $ShipAssembler$_contract_load();
    var res = self~$ShipAssembler$_fun_get_nft_address_by_index($item_index);
    return res;
