_ %get_collection_data() method_id(102491) {
    var self = $ShipAssembler$_contract_load();
    var res = self~$ShipAssembler$_fun_get_collection_data();
    return $CollectionData$_to_external(res);
}

_ lazy_deployment_completed() method_id {
    return get_data().begin_parse().load_int(1);
}

;;
;; Routing of a Contract ShipAssembler
;;

((int, slice, slice, slice, int, int, cell, cell, (int, int, slice)), int) $ShipAssembler$_contract_router_internal((int, slice, slice, slice, int, int, cell, cell, (int, int, slice)) self, int msg_bounced, slice in_msg) impure inline_ref {
    ;; Handle bounced messages
    if (msg_bounced) {
        return (self, true);
    }
    
    ;; Parse incoming message
    int op = 0;
    if (slice_bits(in_msg) >= 32) {
        op = in_msg.preload_uint(32);
    }
    
    
    ;; Receive AssembleShipMessage message
    if (op == 1997904914) {
        var msg = in_msg~$AssembleShipMessage$_load();
        self~$ShipAssembler$_internal_binary_AssembleShipMessage(msg);
        return (self, true);
    }
    
    ;; Receive UpgradeShip message
    if (op == 74989363) {
        var msg = in_msg~$UpgradeShip$_load();
        self~$ShipAssembler$_internal_binary_UpgradeShip(msg);
        return (self, true);
    }
    
    ;; Receive MintNFT message
    if (op == 386813437) {
        var msg = in_msg~$MintNFT$_load();
        self~$ShipAssembler$_internal_binary_MintNFT(msg);
        return (self, true);
    }
    
    ;; Receive UpdatePublicKey message
    if (op == 1766758178) {
        var msg = in_msg~$UpdatePublicKey$_load();
        self~$ShipAssembler$_internal_binary_UpdatePublicKey(msg);
        return (self, true);
    }
    
    ;; Receive WithdrawFunds message
    if (op == 2050115519) {
        var msg = in_msg~$WithdrawFunds$_load();
        self~$ShipAssembler$_internal_binary_WithdrawFunds(msg);
        return (self, true);
    }
    
    ;; Receive Excesses message
    if (op == 3576854235) {
        var msg = in_msg~$Excesses$_load();
        self~$ShipAssembler$_internal_binary_Excesses(msg);
        return (self, true);
    }
    
    ;; Receive ChangeHighload message
    if (op == 2316713580) {
        var msg = in_msg~$ChangeHighload$_load();
        self~$ShipAssembler$_internal_binary_ChangeHighload(msg);
        return (self, true);
    }
    
    ;; Receive ChangeTreasury message
    if (op == 370798756) {
        var msg = in_msg~$ChangeTreasury$_load();
        self~$ShipAssembler$_internal_binary_ChangeTreasury(msg);
        return (self, true);
    }
    
    ;; Receive ChangeRoyaltyParams message
    if (op == 1209124053) {
        var msg = in_msg~$ChangeRoyaltyParams$_load();
        self~$ShipAssembler$_internal_binary_ChangeRoyaltyParams(msg);
        return (self, true);
    }
    
    ;; Receive SetPause message
    if (op == 163970072) {
        var msg = in_msg~$SetPause$_load();
        self~$ShipAssembler$_internal_binary_SetPause(msg);
        return (self, true);
    }
    
    ;; Receive GetRoyaltyParams message
    if (op == 1765620048) {
        var msg = in_msg~$GetRoyaltyParams$_load();
        self~$ShipAssembler$_internal_binary_GetRoyaltyParams(msg);
        return (self, true);
    }
    
    ;; Receive empty message
    if ((op == 0) & (slice_bits(in_msg) <= 32)) {
        self~%$ShipAssembler$_internal_empty();
        return (self, true);
    }
    
    ;; Receive Deploy message
    if (op == 2490013878) {
        var msg = in_msg~$Deploy$_load();
        self~$ShipAssembler$_internal_binary_Deploy(msg);
        return (self, true);
    }
    
    return (self, false);
}

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    var msg_flags = cs~load_uint(4);
    var msg_bounced = -(msg_flags & 1);
    slice msg_sender_addr = __tact_verify_address(cs~load_msg_addr());
    __tact_context = (msg_bounced, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var self = $ShipAssembler$_contract_load();
    
    ;; Handle operation
    int handled = self~$ShipAssembler$_contract_router_internal(msg_bounced, in_msg);
    
    ;; Throw if not handled
    throw_unless(130, handled);
    
    ;; Persist state
    $ShipAssembler$_contract_store(self);
}
