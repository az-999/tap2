_ %get_nft_content(int $index, cell $individual_content) method_id(68445) {
    int $index = $index;
    cell $individual_content = $individual_content;
    var self = $ShipAssembler$_contract_load();
    var res = self~$ShipAssembler$_fun_get_nft_content($index, $individual_content);
    return res;
