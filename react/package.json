{
  "name": "tap-game-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "@telegram-auth/react": "^1.0.3",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@ton/core": "^0.56.3",
    "@tonconnect/sdk": "^3.0.3",
    "@tonconnect/ui-react": "^2.0.6",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.96",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/react-lottie": "^1.2.10",
    "@vkruglikov/react-telegram-web-app": "^2.1.9",
    "axios": "^1.6.8",
    "babel-plugin-styled-components": "^2.0.3",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "flatted": "^3.3.1",
    "fontfaceobserver": "^2.3.0",
    "framer-motion": "^11.2.6",
    "mobx": "^6.12.3",
    "mobx-react-lite": "^4.0.7",
    "monetag-tg-sdk": "^1.0.1",
    "nprogress": "^0.2.0",
    "react": "^18.2.0",
    "react-confetti-explosion": "^2.1.2",
    "react-dom": "^18.2.0",
    "react-flip-numbers": "^3.0.8",
    "react-intersection-observer": "^9.13.0",
    "react-lazy-load-image-component": "^1.6.2",
    "react-lottie": "^1.2.4",
    "react-modal-sheet": "^2.2.0",
    "react-odometerjs": "^3.1.3",
    "react-router-dom": "^6.22.3",
    "react-scripts": "5.0.1",
    "react-tooltip": "^5.26.4",
    "react-transition-group": "^4.4.5",
    "secure-ls": "^2.0.0",
    "styled-components": "^5.3.5",
    "supertest": "^7.0.0",
    "sweetalert2": "^11.11.0",
    "sweetalert2-react-content": "^5.0.7",
    "swiper": "^11.1.14",
    "tonweb": "^0.0.66",
    "typescript": "^4.9.5",
    "use-debounce": "^10.0.1",
    "webpack": "^5.93.0"
  },
  "scripts": {
    "start": "craco start",
    "start:prod": "DISABLE_ESLINT_PLUGIN=true craco start",
    "build": "GENERATE_SOURCEMAP=false craco build",
    "test": "jest ordered-tests.test.js --verbose --watchAll",
    "eject": "craco eject",
    "prettier": "npx prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,less,html,md}'"
  },
  "testEnvironment": "jsdom",
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!(axios)/)"
    ]
  },
  "jest-junit": {
    "suiteName": "tap",
    "outputDirectory": "test",
    "outputName": "front-junit.xml"
  },
  "reporters": [
    "default",
    "jest-junit"
  ],
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/nprogress": "^0.2.3",
    "@types/react-lazy-load-image-component": "^1.6.4",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.10",
    "@types/styled-components": "^5.1.26",
    "@types/supertest": "^6.0.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "prettier-plugin-css-order": "^2.1.2",
    "styled-components.macro": "^1.0.0"
  },
  "babel": {
    "presets": [
      "react-app"
    ],
    "plugins": [
      "macros",
      "babel-plugin-styled-components"
    ]
  }
}
